{
  "name": "@primebrick/dal-pg",
  "version": "3.3.0",
  "description": "Type-driven PostgreSQL Data Access Layer — metadata-based entity decorators, type-safe Repository, bulk ops with TEMP TABLE strategy. Part of the @primebrick/dal-* family (dal-pg, dal-mssql, dal-mariadb, ...).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24"
  },
  "author": "Michael Sogos",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelsogos/primebrick-v3-dal"
  },
  "homepage": "https://github.com/michaelsogos/primebrick-v3-dal#readme",
  "bugs": {
    "url": "https://github.com/michaelsogos/primebrick-v3-dal/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/errors.d.ts",
      "import": "./dist/errors/errors.js"
    }
  },
  "files": [
    "dist/"
  ],
  "bin": {
    "primebrick-db": "./dist/cli/primebrick-db.js"
  },
  "scripts": {
    "version:auto": "node scripts/version-sync.mjs",
    "prebuild": "node scripts/version-sync.mjs && pnpm check:standards && pnpm extract-docs",
    "build": "tsc",
    "prepare": "tsc",
    "test": "pnpm check:standards && vitest run",
    "test:watch": "vitest",
    "test:benchmark": "vitest run --config test/benchmark.vitest.config.ts",
    "extract-docs": "node scripts/extract-api-docs.mjs && node scripts/render-api-reference.mjs",
    "check:standards": "node tools/check-standards.ts src --profile=lib"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@primebrick/core": "workspace:*",
    "pg": "8.23.1",
    "pg-query-stream": "4.17.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.8",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
